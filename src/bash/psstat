#!/usr/bin/env bash
#
# psstat - query process information from the /proc file system.
#
# This script is the deliverable for CISC 7310X Project 1. It reads
# process metadata exclusively from /proc. The `ps` command (and other
# wrappers around it) are intentionally NOT used to gather process
# information.
#
# Modes:
#   --help
#   --list-short
#   --list-long
#   --list-name-has <name_part>
#   --list-pid-is <pid>
#   --list-sched-policy-is <policy_number>
#
set -u

usage() {
    cat <<'EOF'
Usage: psstat [OPTION] ...
List process information.
Options are
 --list-short                  list all processes in short format
 --list-long                   list all processes in long format
 --list-name-has <name_part>   list all processes whose name has name_part in long format
 --list-pid-is <pid>           list status of the process whose pid is <pid>
 --list-sched-policy-is <policy_number> list all processes whose CPU scheduling policy number is <policy_number> in long format
EOF
}

die() {
    echo "psstat: $*" >&2
    echo "Try 'psstat --help' for more information." >&2
    exit 1
}

# --- /proc helpers -------------------------------------------------------

# Numeric list of every PID currently in the system, taken from the numeric
# directory entries under /proc. We do NOT use `ps` here: /proc exposes a
# directory named after each live PID, and globbing the numeric entries is the
# discovery mechanism.
#
# The glob /proc/[0-9]*/ expands in bytewise (lexicographic) order, which is
# NOT numeric ascending (in that order "100" < "9"). We pipe through `sort -n`
# so PIDs come out ascending, matching the reference output.
list_pids() {
    local d pid
    for d in /proc/[0-9]*/; do
        pid="${d#/proc/}"   # -> "<PID>/"
        pid="${pid%/}"      # -> "<PID>"
        printf '%s\n' "$pid"
    done | sort -n
}

# stat_field <pid> <field_number>
# Print the field_number (1-based, per /proc(5) where field 2 is the
# parenthesised comm) from /proc/<pid>/stat.
#
# Why it is written this way: the comm field (field 2) is wrapped in
# parentheses and MAY itself contain spaces and parentheses. A naive
# whitespace split therefore mis-counts fields. The robust approach is to
# anchor on the FIRST '(' and the LAST ')', then split everything after the
# closing ") " into whitespace-separated fields. field N (N >= 3) is the
# (N-3)th such field (0-based index N-3).
stat_field() {
    local raw after comm rest
    local idx
    raw="$(cat "/proc/$1/stat" 2>/dev/null)" || return 1
    after="${raw#*(}"               # text after the first '('
    comm="${after%%)*}"             # up to the first ')'
    rest="${after:${#comm}+2}"      # skip comm, the ')', and the space
    read -r -a rest <<< "$rest" 2>/dev/null || true
    idx=$(( $2 - 3 ))
    printf '%s' "${rest[$idx]-}"
}

# cmdline_fmt <pid>
# Print the CMD_ARGS body (NOT the outer double quotes) built from
# /proc/<pid>/cmdline. Arguments are NUL-separated; each is rendered
# single-quoted and joined by a single space, matching the reference output.
# Prints nothing for kernel threads (empty cmdline).
cmdline_fmt() {
    local args=() a out=""
    while IFS= read -r -d '' a; do
        args+=("$a")
    done < "/proc/$1/cmdline" 2>/dev/null || true
    [ "${#args[@]}" -eq 0 ] && return 0
    for a in "${args[@]}"; do
        out+="'$a' "
    done
    printf '%s' "${out% }"
}

# policy_name <policy_number>
# Map a CPU scheduling policy number to "NAME(num)", using the SCHED_*
# constants defined in /usr/include/linux/sched.h.
policy_name() {
    local n="$1" name
    case "$n" in
        0) name="SCHED_NORMAL" ;;
        1) name="SCHED_FIFO" ;;
        2) name="SCHED_RR" ;;
        3) name="SCHED_BATCH" ;;
        4) name="SCHED_ISO" ;;       # reserved, not implemented
        5) name="SCHED_IDLE" ;;
        6) name="SCHED_DEADLINE" ;;
        7) name="SCHED_EXT" ;;
        *) name="UNKNOWN" ;;
    esac
    printf '%s(%s)' "$name" "$n"
}

# --- modes ---------------------------------------------------------------

# --list-short: one PID per line, header "PID".
cmd_list_short() {
    echo "PID"
    local pid
    for pid in $(list_pids); do
        # Re-check existence: the process may have exited after discovery.
        [ -d "/proc/$pid" ] || continue
        echo "$pid"
    done
}

# emit_long_line <pid>
# Print one long-format line "PID CMD ST CMD_ARGS" for a single process, or
# nothing if the process has vanished or is unreadable. CMD is the image name
# from /proc/<pid>/comm (double-quoted), ST is state (field 3 of stat), and
# CMD_ARGS is the cmdline rendered as single-quoted args (omitted for kernel
# threads that have an empty cmdline).
emit_long_line() {
    local pid="$1" comm st cmdline
    [ -d "/proc/$pid" ] || return 0
    comm="$(cat "/proc/$pid/comm" 2>/dev/null)" || return 0
    st="$(stat_field "$pid" 3)" || return 0
    cmdline="$(cmdline_fmt "$pid")"
    if [ -n "$cmdline" ]; then
        printf '%s "%s" %s "%s"\n' "$pid" "$comm" "$st" "$cmdline"
    else
        printf '%s "%s" %s\n' "$pid" "$comm" "$st"
    fi
}

# --list-long: header "PID CMD ST CMD_ARGS", one line per process.
cmd_list_long() {
    echo "PID CMD ST CMD_ARGS"
    local pid
    for pid in $(list_pids); do
        emit_long_line "$pid"
    done
}

# --list-pid-is <pid>: print a fixed-width status block for one process.
# The value column is right-justified to width 10 immediately after the
# colon (matching the reference output); optional units are appended to
# utime/stime (" clock ticks"), vsize (" bytes") and rss (" pages").
cmd_list_pid_is() {
    local pid="$1"
    local comm state minflt majflt utime stime num_threads vsize rss

    # If the process is gone (exited, or we lack access to its /proc entry),
    # the first cat fails. Surface it the way a read would: "No such file
    # or directory" (see ANSWERS.md, question 9).
    if [ ! -d "/proc/$pid" ]; then
        echo "psstat: process $pid: No such file or directory" >&2
        return 1
    fi
    comm="$(cat "/proc/$pid/comm" 2>/dev/null)"
    state="$(stat_field "$pid" 3)"
    minflt="$(stat_field "$pid" 10)"
    majflt="$(stat_field "$pid" 12)"
    utime="$(stat_field "$pid" 14)"
    stime="$(stat_field "$pid" 15)"
    num_threads="$(stat_field "$pid" 20)"
    vsize="$(stat_field "$pid" 23)"
    rss="$(stat_field "$pid" 24)"
    if [ -z "$comm" ] || [ -z "$state" ]; then
        echo "psstat: process $pid: No such file or directory" >&2
        return 1
    fi

    printf '%15s: %10s%s\n' "pid"         "$pid" ""
    printf '%15s: %10s%s\n' "comm"        "($comm)" ""
    printf '%15s: %10s%s\n' "state"       "$state" ""
    printf '%15s: %10s%s\n' "minflt"      "$minflt" ""
    printf '%15s: %10s%s\n' "majflt"      "$majflt" ""
    printf '%15s: %10s%s\n' "utime"       "$utime" " clock ticks"
    printf '%15s: %10s%s\n' "stime"       "$stime" " clock ticks"
    printf '%15s: %10s%s\n' "num_threads" "$num_threads" ""
    printf '%15s: %10s%s\n' "vsize"       "$vsize" " bytes"
    printf '%15s: %10s%s\n' "rss"         "$rss" " pages"
}

# --list-name-has <name_part>: like --list-long but only for processes whose
# image name (comm) contains <name_part> as a substring. Substring matching is
# done with a bash glob: [[ $comm == *"$name_part"* ]] (equivalent to a regex
# of .*"name".*).
cmd_list_name_has() {
    local name_part="$1" pid comm
    echo "PID CMD ST CMD_ARGS"
    for pid in $(list_pids); do
        [ -d "/proc/$pid" ] || continue
        comm="$(cat "/proc/$pid/comm" 2>/dev/null)" || continue
        if [[ "$comm" == *"$name_part"* ]]; then
            emit_long_line "$pid"
        fi
    done
}

# --- argument dispatch ---------------------------------------------------
if [ "$#" -lt 1 ]; then
    usage >&2
    exit 1
fi

case "$1" in
    --help)
        usage
        ;;
    --list-short)
        cmd_list_short
        ;;
    --list-long)
        cmd_list_long
        ;;
    --list-name-has)
        if [ "${2:-}" = "" ]; then
            die "--list-name-has requires a <name_part> argument"
        fi
        cmd_list_name_has "$2"
        ;;
    --list-pid-is)
        if [ "${2:-}" = "" ]; then
            die "--list-pid-is requires a <pid> argument"
        fi
        cmd_list_pid_is "$2"
        exit $?
        ;;
    *)
        die "unrecognized option: $1"
        ;;
esac

exit 0
