#!/usr/bin/env bash
#
# psstat - query process information from the /proc file system.
#
# This script is the deliverable for CISC 7310X Project 1. It reads
# process metadata exclusively from /proc. The `ps` command (and other
# wrappers around it) are intentionally NOT used to gather process
# information.
#
# Modes:
#   --help
#   --list-short
#   --list-long
#   --list-name-has <name_part>
#   --list-pid-is <pid>
#   --list-sched-policy-is <policy_number>
#
set -u

usage() {
    cat <<'EOF'
Usage: psstat [OPTION] ...
List process information.
Options are
 --list-short                  list all processes in short format
 --list-long                   list all processes in long format
 --list-name-has <name_part>   list all processes whose name has name_part in long format
 --list-pid-is <pid>           list status of the process whose pid is <pid>
 --list-sched-policy-is <policy_number> list all processes whose CPU scheduling policy number is <policy_number> in long format
EOF
}

die() {
    echo "psstat: $*" >&2
    echo "Try 'psstat --help' for more information." >&2
    exit 1
}

# --- argument dispatch ---------------------------------------------------
if [ "$#" -lt 1 ]; then
    usage >&2
    exit 1
fi

case "$1" in
    --help)
        usage
        ;;
    *)
        die "unrecognized option: $1"
        ;;
esac

exit 0
